# Copy to .env and fill in. The real values live there and nowhere in git.
# In production infra sets every one of these on the Scaleway container, and
# RESPONSES_AUTH_TOKEN is the only one it sets as a secret.

# Where chancery POSTs. It appends /responses, so a translator running from
# ../site-dragoman is http://localhost:8080
# Required: serve refuses to boot without it.
RESPONSES_BASE_URL=

# Chancery sends it as `Authorization: Bearer <value>`. Empty in production: the
# translator holds the provider key, and this container holds none.
RESPONSES_AUTH_TOKEN=

# The credential for the translator's own endpoint rather than for a model. Its
# container is private, and Scaleway's gateway checks this header against IAM
# before a request reaches it. Locally the translator is reachable without one,
# so both stay empty; setting one alone is refused at boot.
RESPONSES_GATEWAY_HEADER=
RESPONSES_GATEWAY_TOKEN=

# Port the container listens on. The image already defaults to 8081.
PORT=

# Comma-separated origins a browser may call from. Empty denies every
# cross-origin request; locally this is the site's dev server.
CORS_ORIGINS=

# `development` locally, `production` on the container.
ENV=

# debug, info, warn or error.
LOG_LEVEL=
